# Environment variable template for this repo.
#
# NOTE: this project's actual convention is DB_Config.env, not .env — both notebooks
# call load_dotenv("DB_Config.env"). Copy this file to DB_Config.env and fill in real
# values (never commit DB_Config.env — see the Security note in CLAUDE.md).
#
#   cp .env.example DB_Config.env

# --- MySQL connection (dataUtil.py: get_DBengine, load_df, StoreEOD, ...) ---
DBHOST=127.0.0.1
DBPORT=3306
DBUSER=changeme
DBPWD=changeme
DBMKTDATA=GlobalMarketData
DBPREDICT=changeme
DBWEB=changeme

# --- Table names read by dataUtil.py ---
TBLOPTCHAIN=changeme
TBLDAILYOUTPUT=changeme
TBLDLYPRICE=changeme
TBLDLYPRED=changeme
TBLDAILYPERF=changeme
TBLWEBPREDICT=changeme
TBLUSRATES=changeme

# --- Misc dataUtil.py config ---
API_KEY=changeme
VENDOR=changeme
FIRSTTRAINDTE=2020/01/01
LASTTRAINDATE=2020/12/31
PROD_LIST_DIR=./data
VOL_CON_DIR=./data

# --- Playbook batch script (playbook_etf.py): target DB/table for the parsed rows ---
DBTRADING=Trading
TBLETFOPTIONS=ETF_Options_v1

# --- llmwiki ingestion (Feature A: playbook_etf.py posts page-2 market commentary to
#     POST {LLMWIKI_BASE_URL}/ingest; leave LLMWIKI_BASE_URL unset to skip the upload) ---
LLMWIKI_BASE_URL=http://localhost:8000
LLMWIKI_API_TOKEN=changeme
MAX_LLMWIKI_RETRY=5
LLMWIKI_TIMEOUT=30
