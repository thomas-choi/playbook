# Environment variable template for this repo.
#
# NOTE: this project's actual convention is DB_Config.env, not .env — both notebooks
# call load_dotenv("DB_Config.env"). Copy this file to DB_Config.env and fill in real
# values (never commit DB_Config.env — see the Security note in CLAUDE.md).
#
#   cp .env.example DB_Config.env

# --- MySQL connection (dataUtil.py: get_DBengine, load_df, StoreEOD, ...) ---
DBHOST=127.0.0.1
DBPORT=3306
DBUSER=changeme
DBPWD=changeme
DBMKTDATA=GlobalMarketData
DBPREDICT=changeme
DBWEB=changeme
DBTRADING=changeme

# --- Table names read by dataUtil.py ---
TBLOPTCHAIN=changeme
TBLDAILYOUTPUT=changeme
TBLDLYPRICE=changeme
TBLDLYPRED=changeme
TBLDAILYPERF=changeme
TBLWEBPREDICT=changeme
TBLUSRATES=changeme
TBLSTOCKOPTIONS=changeme
TBLETFOPTIONS=changeme

# --- Misc dataUtil.py config ---
API_KEY=changeme
VENDOR=changeme
FIRSTTRAINDTE=2020/01/01
LASTTRAINDATE=2020/12/31
PROD_LIST_DIR=./data
VOL_CON_DIR=./data

# --- Batch scripts: target DB/table for the parsed rows ---
#     playbook_etf.py -> DBTRADING.TBLETFOPTIONS, top20_stock.py -> DBTRADING.TBLSTOCKOPTIONS
DBTRADING=Trading
TBLETFOPTIONS=ETF_Options_v1
TBLSTOCKOPTIONS=Stock_Options_v1

# --- llmwiki ingestion (Feature A: playbook_etf.py / top20_stock.py post the market commentary to
#     POST {LLMWIKI_BASE_URL}/ingest; leave LLMWIKI_BASE_URL unset to skip the upload) ---
LLMWIKI_BASE_URL=http://localhost:8000
LLMWIKI_API_TOKEN=changeme
MAX_LLMWIKI_RETRY=5
LLMWIKI_TIMEOUT=30

# --- LLM repair of flagged parse blocks (playbook_etf.py / top20_stock.py --llm repair) ---
#     Any OpenAI-standard /v1/chat/completions endpoint: api.openai.com, a gateway, or a local
#     server (ollama: http://localhost:11434/v1, vLLM / LM Studio likewise). Leave LLM_BASE_URL
#     unset to skip the repair pass entirely (flagged blocks are then logged as "unavailable").
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=changeme
LLM_MODEL=qwen2.5:32b
LLM_TEMPERATURE=0
LLM_TIMEOUT=60
LLM_MAX_RETRY=3
# Optional: override the extraction spec used as the system prompt (defaults to the files under
# .claude/skills/lcr-{playbook,top20}-pdf/reference/).
#LLM_SPEC_PLAYBOOK=.claude/skills/lcr-playbook-pdf/reference/playbook-extraction-spec.md
#LLM_SPEC_TOP20=.claude/skills/lcr-top20-pdf/reference/top20-extraction-spec.md
